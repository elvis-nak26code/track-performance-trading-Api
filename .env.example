# ============================================================================
# CONFIGURATION DU BACKEND — Journal de Trading
# Copiez ce fichier en ".env" et renseignez vos propres valeurs.
# Ne JAMAIS committer le fichier ".env" réel (voir .gitignore).
# ============================================================================

# --- Serveur ---------------------------------------------------------------
# Port d'écoute du serveur Express.
PORT=5000

# Environnement : development | production | test
NODE_ENV=development

# URL du frontend autorisée pour les requêtes CORS (celle de votre app Vite).
# En développement, c'est généralement http://localhost:5173
# En production, mettez l'URL réelle de votre frontend déployé.
FRONTEND_URL=http://localhost:5173

# --- Base de données (MongoDB via Mongoose) --------------------------------
# URI de connexion MongoDB. Exemples :
#   Local        : mongodb://127.0.0.1:27017/journal_trading
#   MongoDB Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/journal_trading
MONGODB_URI=mongodb://127.0.0.1:27017/journal_trading

# --- Authentification (JWT) -------------------------------------------------
# Clé secrète utilisée pour signer les tokens JWT.
# IMPORTANT : générez une clé longue et aléatoire en production, par exemple :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# Durée de validité du token JWT (format accepté par la librairie "jsonwebtoken",
# ex: "15m", "1h", "7d", "30d").
JWT_EXPIRES_IN=30d

# --- Connexion Google (OAuth2 / Google Identity Services) -------------------
# Doit être IDENTIQUE au Client ID utilisé côté frontend (VITE_GOOGLE_CLIENT_ID),
# afin que le backend puisse vérifier la signature et l'audience du jeton Google.
GOOGLE_CLIENT_ID=

# --- Sécurité / limitation de débit -----------------------------------------
# Nombre maximum de requêtes d'authentification autorisées par IP sur la
# fenêtre de temps ci-dessous (protection contre le bruteforce).
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# --- Paiement (Genius Pay) ---------------------------------------------------
# Clés fournies par votre espace marchand Genius Pay (Paramètres → API).
# En mode SANDBOX, utilisez les clés sandbox et la base URL ci-dessous ;
# en production, remplacez par vos clés live et l'URL de prod.
# Tant que les clés sont vides, l'app fonctionne normalement mais le paiement
# en ligne renvoie HTTP 501 (PAYMENT_NOT_CONFIGURED) : seul l'Essai est activable.
#
# En-tête X-API-Key (clé publique de la boutique).
GENIUS_PAY_API_KEY=
# En-tête X-API-Secret (clé secrète de la boutique).
GENIUS_PAY_API_SECRET=
# URL de base de l'API Marchand Genius Pay (sans slash final).
GENIUS_PAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
# Secret HMAC des webhooks (whsec_...). Obtenu UNE SEULE FOIS à la création du
# webhook : exécutez `node scripts/create-geniuspay-webhook.js`, puis collez la
# valeur affichée ici. S'il est vide, tous les webhooks sont refusés (sécurité).
GENIUS_PAY_WEBHOOK_SECRET=
# Devise de facturation (FCFA = XOF, devise native de Genius Pay).
GENIUS_PAY_CURRENCY=XOF

# --- Stockage des images (Cloudinary) ----------------------------------------
# Utilisé pour stocker les captures d'écran des entrées de journal.
# Créez un compte gratuit sur https://cloudinary.com pour obtenir ces clés.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- E-mails transactionnels (SMTP) ------------------------------------------
# Bienvenue à l'inscription, confirmation d'abonnement, rappel d'expiration.
# L'application fonctionne SANS ces valeurs : tant que EMAIL_ENABLED n'est pas
# "true" (ou un champ manquant), les envois sont des no-ops journalisés.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BlackTracker <no-reply@votre-domaine.com>

# --- Codes promo -------------------------------------------------------------
# Deux codes sont gérés nativement par l'application :
#  - PROMO_CODE_MONTH    → 1 mois de forfait mensuel offert (une seule fois par compte)
#  - PROMO_CODE_LIFETIME → accès à vie à la plateforme, gratuit
# Les valeurs par défaut permettent de fonctionner sans configuration ;
# changez-les (et gardez-les secrètes) avant la mise en production.
PROMO_CODE_MONTH=BTMOIS2026
PROMO_CODE_LIFETIME=BTLIFE2026
